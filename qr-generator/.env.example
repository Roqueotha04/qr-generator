# MySQL local (Bloque 1). Cuando pases a remoto, solo cambia esta URL.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/qr_generator"

# URL pública que se imprime en el QR. En local: http://localhost:3000
# En producción: https://tudominio.com
APP_BASE_URL="http://localhost:3000"

# Login de un solo admin. El JWT dura 8 horas.
ADMIN_PASSWORD="cambia-esta-clave"
AUTH_SECRET="cambia-este-secreto-largo-minimo-32-chars"
